# Copy to .env at the repo ROOT. Both dev (npm run dev) and prod (docker
# compose on the VM) read this same file.

# ---- Server runtime ----
# dev: development | prod: production
NODE_ENV=production
PORT=3000

# Path to the SQLite database file.
# dev: ./data/app.db (relative to server/) | prod: /data/app.db (docker volume)
DATABASE_PATH=/data/app.db

# Public base URL of the app (used to build the OAuth redirect + secure cookies).
# dev: http://localhost:5173 | prod: https://games.example.com  (no trailing slash)
APP_URL=https://games.example.com

# ---- Google OAuth (from Google Cloud Console -> Credentials) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- Access control ----
# Comma-separated Google account emails of ADMINS. Admins can always sign in and
# are the only ones who can add or remove other users (from the Users page in
# the app). Everyone else is stored in the database — no invitations, an admin
# just adds their email and they sign in with Google.
# (The older name ALLOWED_EMAILS is still read as a fallback.)
ADMIN_EMAILS=you@example.com

# ---- BoardGameGeek (optional) ----
# BGG's XML API requires a registered application since 2025. Register a free
# non-commercial app at https://boardgamegeek.com/applications, create a token,
# and paste it here. Without it, game search is disabled (manual entry works).
BGG_APP_TOKEN=
